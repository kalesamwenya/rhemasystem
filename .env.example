# Copy to .env.local for local Next.js development.
# Production builds use the Hostinger API even if this development URL is present.
NEXT_PUBLIC_API_URL=https://systemtest.citydrivehire.com
# Set to the canonical public website origin in production (no trailing path).
NEXT_SITE_PUBLIC_URL=https://rhemasystem-78th.vercel.app

# Optional communications-only API base URL for the server-side proxy.
# Set this to the same API host used by NEXT_API_URL when overriding locally.
# In production, use the deployed PHP API host; do not add /communications/index.php.
COMMUNICATIONS_API_URL=systemtest.citydrivehire.com
# Optional server-side Moodle integration.
# Never expose MOODLE_TOKEN with a NEXT_API_ prefix.
MOODLE_BASE_URL=
MOODLE_TOKEN=
MOODLE_TIMEOUT_MS=20000
